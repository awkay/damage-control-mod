#!/usr/bin/env bash
# Regenerates every placeholder icon listed in icons.tsv. Run from anywhere.
set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
root="$(cd "$here/../.." && pwd)"
grep -v '^#' "$here/icons.tsv" | while IFS=$'\t' read -r dir glyph badge disabled name; do
	[ -z "$dir" ] && continue
	extra=()
	[ "$disabled" = "disabled" ] && extra=(--disabled)
	python3 -I "$here/make_icons.py" "$root/$dir" "$glyph:$badge:$name" "${extra[@]+"${extra[@]}"}" >/dev/null
	echo "regenerated $dir/$name"
done
