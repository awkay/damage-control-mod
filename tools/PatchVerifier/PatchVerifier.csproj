<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Offline verifier for the Damage Control mod. Never executes game code: game assemblies are
    inspected with MetadataLoadContext / System.Reflection.Metadata only. It does execute two
    third-party libraries the game ships, exactly as the game's mod loader uses them:
      - the C# compiler (Microsoft.CodeAnalysis.CSharp 2.10.0, same version as the game's copy,
        restored from NuGet), to compile the mod with the loader's exact options;
      - Trivial.CodeSecurity (loaded from the game's Managed folder), to run the loader's
        security check against the compiled mod with the loader's restriction set.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RollForward>Major</RollForward>
    <NoWarn>$(NoWarn);NU1701;NU1903;NU1902;NU1904;MSB3277;CS1701;CS1702</NoWarn>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="2.10.0" />
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Compile-time only; resolved at run time from the game's Managed folder. -->
    <Reference Include="Trivial.CodeSecurity">
      <HintPath>$(UboatManaged)Trivial.CodeSecurity.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Trivial.Mono.Cecil">
      <HintPath>$(UboatManaged)Trivial.Mono.Cecil.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
